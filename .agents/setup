#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="$HOME/.local/bin/mise"

system_packages=(
  build-essential
  clang
  cmake
  curl
  elfutils
  gcc
  gettext-base
  git
  g++
  jq
  libasound2-dev
  libfontconfig-dev
  libgit2-dev
  libglib2.0-dev
  libsqlite3-dev
  libssl-dev
  libstdc++-12-dev
  libva-dev
  libvulkan1
  libwayland-dev
  libx11-xcb-dev
  libxkbcommon-x11-dev
  libzstd-dev
  lld
  llvm
  make
  musl-dev
  musl-tools
  pipewire
  xdg-desktop-portal
  zsh
)

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

install_system_packages() {
  local missing=()
  local package

  for package in "${system_packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} == 0)); then
    return
  fi

  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
}

install_mise() {
  if command -v mise >/dev/null 2>&1; then
    mise_bin="$(command -v mise)"
    return
  fi

  if [[ ! -x "$mise_bin" ]]; then
    curl --fail --location --silent --show-error https://mise.run | sh
  fi
}

configure_login_shell() {
  local profile="$HOME/.bash_profile"
  local marker='# Ernie mise activation'

  touch "$profile"
  if ! grep -Fqx "$marker" "$profile"; then
    cat >> "$profile" <<'EOF'

# Ernie mise activation
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi
EOF
  fi
}

run_step 'Install GPUI system dependencies' install_system_packages
run_step 'Install Mise' install_mise
run_step 'Configure login-shell tool activation' configure_login_shell
run_step 'Install pinned development tools' "$mise_bin" install --locked
run_step 'Fetch locked Rust dependencies' \
  "$mise_bin" exec -- cargo fetch --locked \
  --manifest-path "$repo_root/gpui/Cargo.toml"

printf '\nOrb setup complete.\n'
