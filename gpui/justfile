set shell := ["zsh", "-fcu"]

dev:
    cargo run -p ernie-gpui-desktop

run:
    cargo run --release -p ernie-gpui-desktop

build:
    cargo build --release --locked -p ernie-gpui-desktop

check:
    cargo fmt --all -- --check
    cargo check --workspace --locked --all-targets
    cargo test --workspace --locked
    cargo clippy --workspace --locked --all-targets -- -D warnings

check-prime-agent-protocol checkout:
    cargo run -p prime-agent-client --example check_protocol_contract -- {{checkout}}
