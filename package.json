{
  "name": "ernie-dev",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "Electron workbench for Prime Agent.",
  "scripts": {
    "dev": "pnpm ensure:electron && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test": "pnpm typecheck && pnpm test:unit",
    "check": "pnpm test && pnpm test:smoke",
    "package:mac": "pnpm ensure:electron && pnpm check && electron-builder --mac dir --arm64 && node scripts/stage-macos-app.mjs",
    "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
    "test:smoke": "pnpm build && node scripts/electron-smoke.mjs",
    "clean": "rm -rf out dist coverage",
    "runtime:vendor": "scripts/vendor-prime-agent-runtime.sh"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.102",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "agentation": "3.0.2",
    "electron": "41.5.0",
    "electron-builder": "26.15.6",
    "electron-vite": "5.0.0",
    "jsdom": "27.4.0",
    "playwright-core": "1.60.0",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "dev.ernie.workbench",
    "productName": "Ernie Dev",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon-dev.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  },
  "author": "Ernie Dev",
  "license": "MIT"
}
