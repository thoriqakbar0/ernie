{
  "name": "ernie",
  "productName": "Ernie",
  "version": "0.1.0",
  "description": "A desktop client for Prime Agent.",
  "type": "module",
  "main": ".build/main/main.js",
  "private": true,
  "scripts": {
    "start": "nub run build:main && nub run build:renderer && nub --node node_modules/electron/cli.js .",
    "dev": "nub run build:main && nub --node scripts/development.mjs",
    "dev:lynx": "nub run build:main && nub --cwd lynx run build && nub --node .build/main/lynx-host.js",
    "dev:lynx-daemon": "nub run build:main && nub --node .build/main/lynx-daemon-bridge.js",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "nub run build:main && nub run build:renderer",
    "typecheck": "tsc --noEmit",
    "lint:anti-slop": "oxlint --config .oxlintrc.json src scripts tools/oxlint/anti-slop vite.config.mts",
    "lint:boundaries": "depcruise src",
    "test": "nub --test \"src/packages/**/tests/*.test.ts\" \"src/components/tests/*.test.tsx\"",
    "check:react-grab": "nub run build:main && nub run build:renderer && env -u ELECTRON_RUN_AS_NODE nub --node node_modules/electron/cli.js scripts/react-grab-check",
    "check": "nub run typecheck && nub run lint:anti-slop && nub run lint:boundaries && nub run test"
  },
  "keywords": [],
  "author": {
    "name": "thoriq",
    "email": "41317726+thoriqakbar0@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.107",
    "iconoir-react": "^7.11.1",
    "liveline": "^0.0.7",
    "lucide-react": "0.468.0",
    "motion": "^13.0.0",
    "prime-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-0.7.1.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grab": "0.1.50",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "torph": "^0.1.0",
    "tw-animate-css": "^1.4.0",
    "zbsearch": "3.3.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dependency-cruiser": "^18.1.1",
    "electron": "43.3.0",
    "oxlint": "1.78.0",
    "run-local-ci": "0.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "packageManager": "nub@0.7.5",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  }
}
