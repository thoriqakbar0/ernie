{
  "name": "ernie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "node_modules/@zenbujs/core/dist/setup-gate.mjs",
  "scripts": {
    "dev": "nub --node scripts/dev.ts",
    "dev:web": "nub --node scripts/dev.ts web",
    "dev:server": "nub --node scripts/dev.ts server",
    "dev:desktop": "nub --node scripts/dev.ts desktop",
    "build:source": "zen build:source",
    "build:electron": "zen build:electron",
    "publish:source": "zen publish:source",
    "prepare": "husky",
    "link": "zen link",
    "repos:sync": "node scripts/sync-vendored-repos.mjs",
    "db:generate": "zen db generate",
    "doctor": "nub dlx react-doctor@0.9.12 . --no-supply-chain",
    "test:e2e": "nub --node cypress/run.ts",
    "test:e2e:open": "nub --node cypress/run.ts --open",
    "test:integration:browser": "nub --node scripts/browser-test.ts",
    "test:integration:browser:open": "nub --node scripts/browser-test.ts --open",
    "test:desktop-smoke": "nub --node scripts/desktop-smoke.ts",
    "test:integration": "nub --test src/integration/*.integration.test.ts",
    "lint:debt": "debtmap validate . --summary --semantic-off",
    "lint:outline": "nub --node scripts/lint-visible-outline.ts",
    "lint:stylex": "nub --node scripts/lint-stylex.ts",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src/packages",
    "lat:check": "nub dlx lat.md@0.12.2 check",
    "check": "zen link && tsc --noEmit && nub run lint:outline && nub run lint:stylex && nub run lint:boundaries && nub run lat:check && nub run test:integration && nub run test:integration:browser && zen build:source",
    "konsistent": "konsistent"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pi-agent-core": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-core-0.8.1.tgz",
    "@earendil-works/pi-ai": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-ai-0.8.1.tgz",
    "@earendil-works/pi-tui": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-tui-0.8.1.tgz",
    "@fontsource-variable/geist": "^5.3.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^5.0.0",
    "@zenbujs/core": "0.6.0",
    "agentation": "3.0.2",
    "effect": "^4.0.0-rc.112",
    "lucide-react": "^1.39.0",
    "phase": "^0.5.4",
    "prime-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-0.8.1.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "global-jsdom": "^29.0.0",
    "husky": "^9.1.7",
    "konsistent": "^1.0.0-beta.4",
    "react-grab": "^0.2.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thoriqakbar0/ernie.git"
  },
  "zenbu": {
    "host": ">=0.0.0 <0.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
