{
  "name": "ernie",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "node_modules/@zenbujs/core/dist/setup-gate.mjs",
  "scripts": {
    "brand:sync": "nub --node scripts/brand.mjs",
    "brand:check": "nub --node scripts/brand.mjs --check",
    "dev": "nub --node scripts/dev.ts",
    "dev:web": "nub --node scripts/dev.ts web",
    "dev:server": "nub --node scripts/dev.ts server",
    "dev:desktop": "nub --node scripts/dev.ts desktop",
    "build:source": "zen build:source",
    "build:electron": "zen build:electron",
    "publish:source": "nub --node scripts/release.ts",
    "prepare": "husky",
    "link": "zen link",
    "repos:sync": "node scripts/sync-vendored-repos.mjs",
    "db:generate": "zen db generate",
    "doctor": "nub dlx react-doctor@0.9.12 . --no-supply-chain",
    "test:e2e": "nub --node cypress/run.ts",
    "test:e2e:open": "nub --node cypress/run.ts --open",
    "test:integration:browser": "nub --node scripts/browser-test.ts",
    "test:integration:browser:open": "nub --node scripts/browser-test.ts --open",
    "test:desktop-smoke": "nub --node scripts/desktop-smoke.ts",
    "test:integration": "nub --test src/integration/*.integration.test.ts",
    "lint:debt": "debtmap validate . --summary --semantic-off",
    "lint:outline": "nub --node scripts/lint-visible-outline.ts",
    "lint:stylex": "nub --node scripts/lint-stylex.ts",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src/packages",
    "lat:check": "nub dlx lat.md@0.12.2 check",
    "check": "zen link && tsc --noEmit && nub run lint:check && nub run lint:outline && nub run lint:stylex && nub run lint:boundaries && nub run lat:check && nub run test:integration && nub run test:integration:browser && zen build:source",
    "konsistent": "konsistent",
    "lint:unused": "knip",
    "build:history": "nub --node scripts/build-history-desktop.mjs",
    "release:check": "nub --node scripts/release.ts check",
    "release:build": "nub --node scripts/release.ts build-unsigned",
    "test:integration:updates": "nub --test src/integration/updates.integration.test.ts src/integration/update-topology.integration.test.ts",
    "lint": "oxlint",
    "lint:check": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:doctor": "ultracite doctor",
    "format:check": "oxfmt --check",
    "format": "oxfmt --write",
    "release:build:unsigned": "nub --node scripts/release.ts build-unsigned",
    "release:preview": "bash scripts/release-distribution.sh preview",
    "release:prepare": "nub --node scripts/release-channel.ts",
    "release:build:signed": "nub --node scripts/release.ts build",
    "release:prod": "bash scripts/release-distribution.sh prod",
    "dev:check": "nub run link && nub run typecheck",
    "release:source:init": "nub --node scripts/release.ts init",
    "release:source:push": "nub --node scripts/release.ts push"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@scritto/react": "^0.1.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^5.0.0",
    "@zenbujs/core": "0.6.0",
    "agentation": "3.0.2",
    "effect": "^4.0.0-rc.112",
    "interface-kit": "^0.1.3",
    "isomorphic-git": "1.37.6",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "prime-agent": "https://github.com/PrimeIntellect-ai/prime-agent/releases/download/v0.9.3/prime-agent-0.9.3.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.0",
    "shiki": "^4.4.3",
    "vite": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.7.1",
    "dependency-cruiser": "^18.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "husky": "^9.1.7",
    "knip": "6.34.0",
    "konsistent": "^1.0.0-beta.4",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-react-doctor": "0.9.13",
    "react-grab": "^0.2.0",
    "typescript": "^5.9.3",
    "ultracite": "7.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thoriqakbar0/ernie.git"
  },
  "zenbu": {
    "host": ">=0.2.0 <0.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "overrides": {
      "@earendil-works/pi-agent-core": "https://github.com/PrimeIntellect-ai/prime-agent/releases/download/v0.9.3/prime-agent-core-0.9.3.tgz",
      "@earendil-works/pi-ai": "https://github.com/PrimeIntellect-ai/prime-agent/releases/download/v0.9.3/prime-agent-ai-0.9.3.tgz",
      "@earendil-works/pi-tui": "https://github.com/PrimeIntellect-ai/prime-agent/releases/download/v0.9.3/prime-agent-tui-0.9.3.tgz"
    }
  }
}
