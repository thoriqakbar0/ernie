{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.mts"],
  "exclude": [
    "src/main.ts",
    "src/lynx-host.ts",
    "src/packages/ernie-agent-interaction/index.ts",
    "src/packages/prime-agent-daemon/daemon-runner.ts",
    "src/packages/session-name-hook/index.ts"
  ]
}
